 //-- AddPtrOp --
-#ifdef WITH_ASCEND
-OpFoldResult AddPtrOp::fold(FoldAdaptor adaptor) { return {}; }
-#else
 OpFoldResult AddPtrOp::fold(FoldAdaptor adaptor) {
+  // Ascend's LoadStoreCanonicalizer needs this workaround. It must not change
+  // Wafer or CUDA IR just because npu-smi happens to exist on the build host.
+  if (auto module = (*this)->getParentOfType<ModuleOp>();
+      module && module->hasAttr("dicp.disable_addptr_fold"))
+    return {};
   // addptr(ptr, 0) -> ptr
   if (matchPattern(adaptor.getOffset(), m_Zero())) {
     return getPtr();
   }
   return {};
 }
-#endif
 
